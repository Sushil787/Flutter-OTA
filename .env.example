# Flutter OTA configuration. Copy to `.env` (git-ignored) and adjust.
#
# Both halves read this one file: the server takes UPLOAD_TOKEN, and the CLI
# takes the same value to authorize uploads. A real environment variable of the
# same name wins over the file, which is how CI supplies the token.

# Shared secret for uploads. The CLI sends it as `Authorization: Bearer <token>`
# and the server rejects uploads that do not match.
UPLOAD_TOKEN=dev-secret

# Where the CLI uploads to. Lets you drop `--server` from every command.
FLUTTER_OTA_SERVER=http://localhost:8080

# Port the server listens on.
PORT=8080
